# ==============================================================================
# ตัวอย่างไฟล์ตั้งค่าระบบ (.env.example) — โปรเจกต์ร้านต้นมะค่า แคมป์ปิ้งบาร์หมูกระทะ
# วิธีใช้งาน: คัดลอกไฟล์นี้เป็นชื่อ .env ในโฟลเดอร์เดียวกับ config.py แล้วกรอกค่าจริง
# คำเตือน: ห้ามนำไฟล์ .env ขึ้น Git หรือแชร์ให้ผู้อื่นเด็ดขาด
# ==============================================================================

# ------------------------------------------------------------------------------
# ก) อีเมลผู้ส่ง (สำหรับส่งรหัส OTP ยืนยันการสมัครสมาชิกและตั้งรหัสผ่านใหม่)
# ------------------------------------------------------------------------------

# เซิร์ฟเวอร์ SMTP ของผู้ให้บริการอีเมล (ค่าเริ่มต้น: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# พอร์ตเชื่อมต่อ SMTP (587 = STARTTLS แนะนำสำหรับ Gmail, 465 = SSL)
SMTP_PORT=587

# บัญชีอีเมลผู้ส่ง (เช่น yourshop@gmail.com)
SMTP_USER=

# รหัสผ่านสำหรับแอป (App Password 16 ตัวอักษรของ Gmail ไม่ใช่รหัสผ่านเข้าอีเมลปกติ)
# วิธีสร้าง: เข้าบัญชี Google -> Security -> เปิด 2-Step Verification -> App passwords -> สร้างรหัส 16 ตัวอักษร
SMTP_PASSWORD=

# ชื่อผู้ส่งที่แสดงในหัวจดหมาย (ถ้าเว้นว่างจะใช้ชื่อร้านจากระบบ)
SMTP_FROM_NAME=ต้นมะค่า แคมป์ปิ้งบาร์หมูกระทะ

# อีเมลผู้ส่งในหัวจดหมาย (ว่าง = ใช้ค่าเดียวกับ SMTP_USER; ถ้าตั้งต้องเป็นอีเมลบัญชีเดียวกับ SMTP_USER)
SMTP_FROM=

# ------------------------------------------------------------------------------
# ข) ความปลอดภัย OTP
# ------------------------------------------------------------------------------

# คีย์ลับสำหรับแฮชรหัส OTP ด้วย HMAC-SHA256 (ควรยาวอย่างน้อย 32 ตัวอักษร)
# คำสั่งสร้างคีย์สุ่มที่ปลอดภัย:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# หากเว้นว่าง ระบบจะสุ่มค่าชั่วคราวต่อโปรเซส (รหัส OTP ที่ส่งไปแล้วจะใช้ไม่ได้หากรีสตาร์ตเซิร์ฟเวอร์)
OTP_SECRET=

# ------------------------------------------------------------------------------
# ค) ระบบสมาชิก
# ------------------------------------------------------------------------------

# การเปิดใช้บัญชีตัวอย่างสำหรับทดสอบ (0 = ปิดบัญชีตัวอย่างในการใช้งานจริง, 1 = เปิดเฉพาะตอนพัฒนา)
MEMBER_DEMO_ACCOUNTS=0
